# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String
# Example: mongodb://localhost:27017/clinc_ai
MONGO_URI=mongodb://localhost:27017/clinc_ai

# AES-256 Encryption Key (Must be 32 bytes/64 hex characters)
# Generate a new one using Node.js: require('crypto').randomBytes(32).toString('hex')
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret for Auth
JWT_SECRET=your_jwt_super_secret_key_here
